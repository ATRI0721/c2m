# Code2MCP Environment Configuration
# Copy this file to .env and update with your values

# ==============================
# Security Configuration (REQUIRED)
# ==============================
# Generate a secure key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=your-secret-key-here-change-in-production

# ==============================
# AI Model Configuration
# ==============================
# OpenAI API Key (or compatible service)
OPENAI_API_KEY=your-openai-api-key-here

# OpenAI Base URL (change if using a compatible service)
OPENAI_BASE_URL=https://api.openai.com/v1

# Default model to use
DEFAULT_MODEL=gpt-4o-mini

# ==============================
# Frontend Configuration
# ==============================
# Frontend URL (for CORS) - nginx serves on port 80
FRONTEND_URL=http://localhost

# Allowed origins for CORS (comma-separated)
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://localhost:5174

# Backend API URL (for frontend build) - nginx proxies /api to backend
VITE_API_URL=http://localhost:8000

# ==============================
# Database Configuration
# ==============================
# Database URL (SQLite for development, PostgreSQL for production)
DATABASE_URL=sqlite:///./data/app.db

# For PostgreSQL production use:
# DATABASE_URL=postgresql://user:password@localhost:5432/code2mcp

# ==============================
# Admin Configuration
# ==============================
# Admin emails (JSON array format)
ADMIN_EMAILS=["admin@localhost"]

# ==============================
# Public Access Configuration
# ==============================
# Publicly accessible agents (JSON array format)
PUBLIC_AGENTS=["chat", "city", "weather", "code"]

# Admin-only agents (JSON array format)
ADMIN_AGENTS=["assistant"]

# Publicly accessible MCP servers (JSON array format)
PUBLIC_MCP_SERVERS=["environment", "usgs-quakes", "geocoding", "osm", "overpass", "opentripmap", "wikidata", "population", "opengov", "exchange-rate"]

# MCP servers to skip (JSON array format)
MCP_SKIP_SERVERS=[]

# ==============================
# Logging Configuration
# ==============================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ==============================
# Optional: Production Settings
# ==============================
# Uncomment for production deployment

# # Use PostgreSQL
# DATABASE_URL=postgresql://code2mcp:password@db:5432/code2mcp

# # Set production origins
# FRONTEND_URL=https://your-domain.com
# ALLOWED_ORIGINS=https://your-domain.com,https://www.your-domain.com
# VITE_API_URL=https://api.your-domain.com

# # Strong secret key (generate new one for production)
# SECRET_KEY=<generate-with-python>-<unique-for-production>
