# =============================================================================
# Code2MCP Backend Environment Variables
# =============================================================================
# Copy this file to .env and update the values for your environment

# =============================================================================
# REQUIRED - Security
# =============================================================================
# Generate a secure key with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-this-secret-key-in-production-use-openssl-rand-hex-32

# =============================================================================
# Database Configuration
# =============================================================================
# SQLite (default)
DATABASE_URL=sqlite:///./data/app.db

# PostgreSQL (alternative for production)
# DATABASE_URL=postgresql://user:password@localhost:5432/code2mcp

# =============================================================================
# AI Model Configuration
# =============================================================================
# OpenAI API Configuration
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_MODEL=gpt-4o-mini

# =============================================================================
# Frontend Configuration
# =============================================================================
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost,http://localhost:80,http://localhost:5173,http://localhost:5174

# =============================================================================
# Admin Configuration
# =============================================================================
# Comma-separated list of admin emails
ADMIN_EMAILS=["Admin@localhost"]

# =============================================================================
# Public Access Lists (JSON array format)
# =============================================================================
# Agents accessible to regular users
PUBLIC_AGENTS=["chat", "city", "weather", "code"]

# MCP servers accessible to regular users
PUBLIC_MCP_SERVERS=["environment", "usgs-quakes", "geocoding", "osm", "overpass", "opentripmap", "wikidata", "population", "opengov", "exchange-rate"]

# Agents with full admin access
ADMIN_AGENTS=["assistant"]

# =============================================================================
# MCP Configuration
# =============================================================================
# Servers to skip during startup (JSON array format)
MCP_SKIP_SERVERS=[]

# =============================================================================
# Logging Configuration
# =============================================================================
# Options: CRITICAL, ERROR, WARNING, INFO, DEBUG
LOG_LEVEL=INFO
